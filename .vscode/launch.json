{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug jibjack_trivia",
      "cargo": {
        "args": ["build", "--bin=jibjack_trivia", "--package=jibjack_trivia"],
        "filter": {
          "name": "jibjack_trivia",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "cargo build"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug tests",
      "cargo": {
        "args": ["test", "--no-run", "--package=jibjack_trivia"],
        "filter": {
          "name": "jibjack_trivia",
          "kind": "test"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "cargo test build"
    }
  ]
}
