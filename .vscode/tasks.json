{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo build",
      "type": "shell",
      "command": "cargo",
      "args": ["build"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo test build",
      "type": "shell",
      "command": "cargo",
      "args": ["test", "--no-run"],
      "group": "build",
      "problemMatcher": ["$rustc"]
    }
  ]
}
